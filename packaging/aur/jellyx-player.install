post_install() {
  echo ""
  echo "==> Jellyx Player installed successfully."
  echo ""
  echo "    GStreamer base/good plugins are required for WebKit audio playback."
  echo "    yt-dlp is used for online sources and can be downloaded by Jellyx."
  echo ""
  echo "    Optional runtime dependencies:"
  echo "      - pipewire-pulse or pulseaudio: Audio output backend"
  echo ""
}

post_upgrade() {
  post_install
}

post_remove() {
  echo ""
  echo "==> Jellyx Player removed."
  echo ""
  echo "    Auto-downloaded yt-dlp binary may remain in:"
  echo "      ~/.local/share/jellyx/bin/"
  echo ""
  echo "    To remove it: rm -rf ~/.local/share/jellyx/"
  echo ""
}
