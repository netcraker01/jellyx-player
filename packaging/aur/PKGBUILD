# Maintainer: netcraker01 <netcraker01@users.noreply.github.com>
pkgname=jellyx-player
pkgver=0.4.4
pkgrel=1
pkgdesc="Desktop background music player for YouTube, SoundCloud, and local files"
arch=('x86_64')
url="https://github.com/netcraker01/jellyx-player"
license=('AGPL-3.0-or-later')
depends=(
  'gtk3'
  'webkit2gtk-4.1'
  'gst-plugins-base-libs'
  'gst-plugins-good'
)
optdepends=(
  'yt-dlp: Stream resolution for online sources (Jellyx can download it on first launch)'
  'pipewire-pulse: Audio output on PipeWire systems'
  'pulseaudio: Audio output on PulseAudio systems'
)
provides=('jellyx')
conflicts=('jellyx')
options=('!strip')
install='jellyx-player.install'
_deb="Jellyx.Player_${pkgver}_amd64.deb"
source=(
  "${_deb}::https://github.com/netcraker01/jellyx-player/releases/download/v${pkgver}/${_deb}"
  "LICENSE::https://raw.githubusercontent.com/netcraker01/jellyx-player/v${pkgver}/LICENSE"
)
sha256sums=(
  'b9fcf562fc6d582003aa1107dcb6faa235d1ede8973a681689c7cf399a0365b5'
  'd686be348ac333b02f12218ccb06141e9eaca33ab80e05a5b0ec1a76d6a63dbd'
)

package() {
  local appdir="${srcdir}/deb-root"
  mkdir -p "${appdir}"
  bsdtar -xOf "${srcdir}/${_deb}" data.tar.gz | bsdtar -xzf - -C "${appdir}"

  install -Dm755 "${appdir}/usr/bin/jellyx" "${pkgdir}/usr/bin/jellyx"
  install -Dm644 "${appdir}/usr/share/applications/Jellyx Player.desktop" \
    "${pkgdir}/usr/share/applications/jellyx-player.desktop"
  sed -i \
    -e 's/^Icon=jellyx$/Icon=multimedia-audio-player/' \
    -e 's/^Categories=$/Categories=AudioVideo;Audio;Player;/' \
    "${pkgdir}/usr/share/applications/jellyx-player.desktop"
  install -Dm644 "${srcdir}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
